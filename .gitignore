# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/scripts/catalog/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/bin
/db/*.sqlite
/db/*.sqlite-shm
/db/*.sqlite-wal
/data/captures/*
!/data/captures/.gitkeep
/assets/ai/*
!/assets/ai/silero_vad_v6.onnx
!/assets/ai/silero_vad_v6.onnx.sha256
/runtime/ai-venv/
/runtime/python/
/runtime/tools/
/runtime/uv-cache/
/runtime/ai-models/
__pycache__/
*.pyc

# misc
.DS_Store
*.sync-conflict-*
*.pem
/.cache/
/public/tiles/osm/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
